# Scholar Sense AI — Server Environment Variables
# Copy this file to .env and fill in all values before starting the server.

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<pass>@cluster.mongodb.net/
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster.mongodb.net/

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d

# ─── LLM (Google Gemini — get free key at aistudio.google.com) ───────────────
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ─── Uploads ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760
UPLOAD_DIR=uploads
